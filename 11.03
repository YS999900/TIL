## 딕셔너리 (Dictionaray)

- {"키": "값"}
- "키" 중복 불가
- '값" 중복 가능
- 추가하는 순서를 유지
#
# {"a":1}
# {"a":1}, {"b":2}
# print({"a": 1, "b": 2})
print({"a": 1, "b": 2})

user_info = {
"name": "BaeYuSeong",
"age": 30
}

print(user_info)

print(user_info["age"]) # 키로 값을 가져오기
user_info["age"] = 32
print(user_info["age"])
user_info["role"] = "Tutor"

print(user_info)
### 삭제
user_info = {

"name": "BaeYuSeong",
"age": 30,
"role": "admin"
}

print (user_info)
# del 메서드 사용
del user_info["role"]

print (user_info)

# pop 사용 : 꺼내면서 삭제
age = user_info.pop("age")
print (age, user_info)
### 딕셔너리 주요 메서드

- keys(), values(), items()
menu = {"coffe" : 4000, "tea": 4500}

# key 목로 조회
print(menu.keys())
# value 목록조회
print(menu.values())
# items 조회 (키, 값) 튜플 형태로 리턴
print(menu.items())

# 딕셔너리는 인덱서 방식으로 값을 참조 불가 > list로 변환
print(list(menu.keys())[0])

print(sum(menu.values()))
print ("coffee" in menu) # True
print ( 4000 in menu)

print ( 4000 in menu.values()) # True
# menu["cake"]
price = menu.get("cake", 5000)

print(price)

# default 값이 없는 경우 none
print(menu.get("cake"))

print(menu.get("coffee", 0))

print(menu)
### 집합 (set)

수학 집합 : 중복 없고, 순서 없는 자료형

- 중괄호 사용
- set() 함수를 생성
grade = set([1, 2, 2, 3, 3, 3])

print(grade)
print(type({})) # {} 빈 딕셔너리
print(type(set())) # set() 빈 집합
print({1, 2, 2}) # 집합
s = {1, 2}

s.add(2)
s.add(5)

print(s)

s.remove(1)
print(s)

s.discard(20) # 없는 키 삭제할 때도 오류값 없음
print(s)
set_a = {1, 2, 3}
set_b = {3, 4, 5}

print(set_a & set_b) # 교집합 
print(set_a | set_b) # 합집합
print(set_a - set_b) # 차집합
print(3 in set_a) # 포함 여부
### 중복제거
# 원시 데이터
raw_emails = ["a@sparta.com", "b@sparta.com", "a@sparta.com"]

# 집합으로 중복 제거
unique_set = set(raw_emails)

print(list(unique_set))

print("# 중복제거 및 순서 유지")
sort_emails = (dict.fromkeys(raw_emails))
print(sort_emails)

# sroted

print(sorted(set(["c", "d", "a", "f", "a"])))

