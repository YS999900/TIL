score = 100
score += 50 # score = score + 50
score %= 3 # score = score % 3
score //= 2 # score = score // 2

a= 10
print(a == 10)
print(a != 10)

print(a > 10)
print(a < 10)
print(a >= 10)
print(a <= 10)

